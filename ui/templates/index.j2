{% extends "base.j2" %}

{% block title %}ホーム - Voracity2 Dashboard{% endblock %}

{% block content %}
<div class="row">
    <div class="col-12">
        <h1 class="mb-4">
            <i class="bi bi-speedometer2"></i>
            Voracity2 Dashboard
        </h1>
        <p class="lead">クロール作業の進捗状況とプロキシ状態を監視できます。</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body text-center">
                <div class="display-4 text-primary mb-3">
                    <i class="bi bi-bar-chart"></i>
                </div>
                <h5 class="card-title">ジョブ進捗</h5>
                <p class="card-text">現在実行中のクロール作業の進捗状況を確認できます。</p>
                <a href="{{ url_for('job_progress') }}" class="btn btn-primary">
                    <i class="bi bi-arrow-right"></i>
                    進捗を確認
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body text-center">
                <div class="display-4 text-success mb-3">
                    <i class="bi bi-shield-check"></i>
                </div>
                <h5 class="card-title">プロキシ状況</h5>
                <p class="card-text">プロキシサーバーの状態と可用性を監視できます。</p>
                <a href="{{ url_for('proxy_status') }}" class="btn btn-success">
                    <i class="bi bi-arrow-right"></i>
                    状況を確認
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body text-center">
                <div class="display-4 text-info mb-3">
                    <i class="bi bi-journal-text"></i>
                </div>
                <h5 class="card-title">クロール履歴</h5>
                <p class="card-text">過去のクロール作業の履歴と結果を閲覧できます。</p>
                <a href="{{ url_for('crawl_logs') }}" class="btn btn-info">
                    <i class="bi bi-arrow-right"></i>
                    履歴を確認
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
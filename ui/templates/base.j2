<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Voracity2 Dashboard{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
</head>
<body class="bg-light">
    <!-- ナビゲーションバー -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand" href="{{ url_for('index') }}">
                <i class="bi bi-speedometer2"></i>
                Voracity2
            </a>
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link {% if request.endpoint == 'index' %}active{% endif %}" 
                           href="{{ url_for('index') }}">
                            <i class="bi bi-house"></i>
                            ホーム
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {% if request.endpoint == 'job_progress' %}active{% endif %}" 
                           href="{{ url_for('job_progress') }}">
                            <i class="bi bi-bar-chart"></i>
                            ジョブ進捗
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {% if request.endpoint in ['proxy_status', 'proxy_status_detail'] %}active{% endif %}" 
                           href="{{ url_for('proxy_status') }}">
                            <i class="bi bi-shield-check"></i>
                            プロキシ状況
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {% if request.endpoint == 'crawl_logs' %}active{% endif %}" 
                           href="{{ url_for('crawl_logs') }}">
                            <i class="bi bi-journal-text"></i>
                            クロール履歴
                        </a>
                    </li>
                </ul>
                
                <!-- 右側の情報 -->
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <span class="navbar-text">
                            <i class="bi bi-clock"></i>
                            <span id="current-time"></span>
                        </span>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- メインコンテンツ -->
    <main class="container my-4">
        {% block content %}{% endblock %}
    </main>

    <!-- フッター -->
    <footer class="bg-dark text-light text-center py-3 mt-5">
        <div class="container">
            <small>&copy; 2024 Voracity2 Dashboard. All rights reserved.</small>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // 現在時刻の表示
        function updateTime() {
            const now = new Date();
            const timeString = now.toLocaleString('ja-JP', {
                year: 'numeric',
                month: '2-digit',
                day: '2-digit',
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit'
            });
            document.getElementById('current-time').textContent = timeString;
        }
        
        // 初期表示と1秒ごとの更新
        updateTime();
        setInterval(updateTime, 1000);
        
        // 自動リロード機能
        let autoReloadInterval = null;
        
        function setAutoReload(seconds) {
            // 既存のタイマーをクリア
            if (autoReloadInterval) {
                clearInterval(autoReloadInterval);
                autoReloadInterval = null;
            }
            
            // 新しいタイマーを設定
            if (seconds > 0) {
                autoReloadInterval = setInterval(() => {
                    location.reload();
                }, seconds * 1000);
            }
            
            // 選択状態を保存
            localStorage.setItem('autoReloadInterval', seconds);
        }
        
        // ページ読み込み時に設定を復元
        document.addEventListener('DOMContentLoaded', function() {
            const savedInterval = localStorage.getItem('autoReloadInterval');
            if (savedInterval && savedInterval !== '0') {
                const selectElement = document.getElementById('autoReloadSelect');
                if (selectElement) {
                    selectElement.value = savedInterval;
                    setAutoReload(parseInt(savedInterval));
                }
            }
        });
    </script>
    
    {% block scripts %}{% endblock %}
</body>
</html>